---
layout: layout.njk
title: Releases
---
{# Edit src/_data/releases.json to add a release. The date comes from the version number. #}
<div class="px-6 pt-16 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-base font-semibold leading-7 text-indigo-600">Releases</h1>
        <p class="mt-2 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
            Always up to date
        </p>
        <p class="mx-auto mt-6 text-lg leading-8 text-gray-600">
            Manager.io is being continuously updated to keep getting better than ever.
        </p>
    </div>
</div>

<div class="mx-auto w-full max-w-4xl px-4 sm:px-6 pt-12 pb-16">
    {% for month in releases | releaseMonths %}
    <section class="mb-6 rounded-xl bg-white ring-1 ring-gray-200 overflow-hidden">
        <header class="border-b border-gray-200 bg-gray-50/70 px-5 py-2.5">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500">{{ month.heading }}</h2>
        </header>
        <ul class="divide-y divide-gray-100">
            {% for release in month.items %}
            <li class="group flex items-start gap-4 px-4 sm:px-5 py-4 hover:bg-gray-50 transition-colors">
                <div class="flex-none w-14 text-right">
                    <div class="text-sm font-semibold text-gray-900 whitespace-nowrap">{{ release.day }}</div>
                    <div class="text-xs text-gray-400">{{ release.weekday }}</div>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm text-gray-800 leading-6 break-words">{{ release.description }}</p>
                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                        <a href="https://forum.manager.io/t/{{ release.topic }}" target="_blank" rel="noopener"
                           class="inline-flex items-center gap-1 text-sky-600 hover:text-sky-700">
                            <i class="fas fa-comments"></i>
                            <span>Discuss on forum</span>
                        </a>
                    </div>
                </div>
                <div class="flex-none self-center">
                    <span class="text-xs font-mono text-gray-400">
                        {{ release.version }}
                    </span>
                </div>
            </li>
            {% endfor %}
        </ul>
    </section>
    {% else %}
    <div class="rounded-xl bg-white ring-1 ring-gray-200 p-10 text-center">
        <i class="fa fa-box-open fa-2x text-gray-300"></i>
        <p class="mt-3 text-gray-500">No releases yet.</p>
    </div>
    {% endfor %}
</div>
