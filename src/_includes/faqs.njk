{# Questions and answers from the page's front matter: faqs: [{ q, a }]. Answers may contain HTML.
   Set faqWidth (a max-w-* class) before including to match a narrower page. #}
<div class="mx-auto {{ faqWidth or "max-w-7xl" }} divide-y divide-gray-900/10 px-6 py-16 lg:px-8" id="faq">
    <h2 class="text-2xl font-bold leading-10 tracking-tight text-gray-900">
        Frequently Asked Questions
    </h2>

    <div class="mt-10 space-y-8 divide-y divide-gray-900/10">
        {% for faq in faqs %}
        <div class="pt-8 lg:grid lg:grid-cols-12 lg:gap-8">
            <div class="text-base font-semibold leading-7 text-gray-900 lg:col-span-5">
                {{ faq.q }}
            </div>
            <div class="mt-4 lg:col-span-7 lg:mt-0">
                <p class="text-base leading-7 text-gray-600">
                    {{ faq.a | safe }}
                </p>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
