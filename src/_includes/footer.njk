{% set footerSections = [
    { title: "Products", links: [
        { label: "Desktop Edition", url: "/" },
        { label: "Cloud Edition", url: site.cloud },
        { label: "Server Edition", url: "/server-edition/" }
    ] },
    { title: "Support", links: [
        { label: "Guides", url: "/guides/" },
        { label: "Forum", url: "https://forum.manager.io", external: true }
    ] },
    { title: "Partners", links: [
        { label: "Accountants", url: "/accountants/" },
        { label: "Advisors", url: "/advisors/" }
    ] },
    { title: "Get Involved", links: [
        { label: "Extend", url: "/extend/" }
    ] }
] %}
<div class="bg-gray-50 border-t border-gray-200 mt-16">
    <div class="py-12 px-6 lg:px-8">
        <div class="w-full max-w-7xl mx-auto">
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-2 md:grid-cols-4">
                {% for section in footerSections %}
                <div>
                    <div class="font-semibold pb-3 text-base sm:text-lg text-neutral-600">
                        {{ section.title }}
                    </div>
                    {% for link in section.links %}
                    <a href="{{ link.url }}"{% if link.external %} target="_blank"{% endif %} class="block py-1.5 text-sm sm:text-base text-neutral-500 hover:text-neutral-800 flex gap-1.5 items-center">
                        {{ link.label }}
                        {% if link.external %}<i class="fas fa-external-link-square opacity-50 text-xs"></i>{% endif %}
                    </a>
                    {% endfor %}
                </div>
                {% endfor %}
            </div>
            {# Download pages in other languages. Only the translated ones are listed. #}
            <div class="mt-10 pt-6 border-t border-gray-200 flex flex-wrap gap-x-4 gap-y-2 text-sm text-neutral-500" dir="ltr">
                <a href="/download/" lang="en" hreflang="en" class="hover:text-neutral-800">English</a>
                {% for language in languages %}{% if translations[language.code] %}
                <a href="/{{ language.code }}/" lang="{{ language.code }}" hreflang="{{ language.code }}" class="hover:text-neutral-800">{{ language.nativeName }}</a>
                {% endif %}{% endfor %}
            </div>
        </div>
    </div>
</div>
