<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title | safe }} | {% endif %}Manager.io</title>
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/style.css">
    <script src="https://kit.fontawesome.com/0b64f5ae8f.js" crossorigin="anonymous"></script>
    <script defer data-domain="manager.io" src="/js/script.js"></script>
    {%- if redirect %}
    <meta http-equiv="refresh" content="0; url={{ redirect }}">
    <link rel="canonical" href="{{ redirect }}">
    {%- endif %}
</head>
<body class="flex min-h-full bg-white dark:bg-slate-900">
    <div id="app" class="flex w-full flex-col">
        {% include "header.njk" %}
        {% if breadcrumb != false %}{% include "breadcrumb.njk" %}{% endif %}
        <div id="content"{% if contentDir %} dir="{{ contentDir }}"{% endif %}>
            {{ content | safe }}
            {% include "footer.njk" %}
        </div>
    </div>
</body>
</html>
