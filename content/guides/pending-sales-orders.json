{
  "content": "<h1><span translate=\"true\" keyword=\"SalesOrders\">Sales Orders</span> &mdash; <span translate=\"true\" keyword=\"Pending\">Pending</span></h1><p translate=\"true\" keywords=\"Is On Orders Pending RecurringSalesOrder RecurringSalesOrders Sales SalesOrder SalesOrders To ToDate\">The <strong>Pending Sales Orders</strong> screen displays all recurring sales orders that are ready to be processed.</p><p translate=\"true\" keywords=\"Date RecurringSalesOrder Sales SalesOrder View\">When a recurring sales order reaches its scheduled date, it appears here for your review.</p><p translate=\"true\" keywords=\"Action Actual By Create HasOrderBy On Sales SalesOrder To ToDate\">You can then create the actual sales order by clicking the appropriate action button.</p><details><summary><span translate=\"true\" keyword=\"NextIssueDate\">Next issue date</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"NextIssueDate\">Next issue date</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Actual Create Date Is RecurringSalesOrder Sales SalesOrder To ToDate\">Displays the date when this recurring sales order is scheduled to be created as an actual sales order.</p></div></details><details><summary><span translate=\"true\" keyword=\"Customer\">Customer</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"Customer\">Customer</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Create Custom Customer Is Sales SalesOrder To ToDate\">Displays the customer who will receive this sales order when it is created.</p></div></details><details><summary><span translate=\"true\" keyword=\"Description\">Description</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"Description\">Description</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Description Is On RecurringSalesOrder Reference Sales SalesOrder\">Displays the description or reference information for this recurring sales order.</p></div></details>",
  "key": "pending-sales-orders"
}
