{
  "content": "<h1><span translate=\"true\" keyword=\"Account\">Account</span> &mdash; <span translate=\"true\" keyword=\"Billable_time_invoiced\">Billable time - invoiced</span></h1><p translate=\"true\" keywords=\"Account Billable_time Billable_time_invoiced BillableTime Code Count Invoice Invoiced Is Name Rename To ToDate\">This form allows to rename built-in <code>Billable time - invoiced</code> account.</p><p translate=\"true\" keywords=\"Account Accounts Billable_time Billable_time_invoiced BillableTime ChartOfAccounts Code Count Edit Invoice Invoiced Is On Settings To ToDate\">To access this form, go to <code>Settings</code>, then <code>Chart of Accounts</code>, then click <code>Edit</code> button for <code>Billable time - invoiced</code> account.</p><p translate=\"true\" keywords=\"Contains On\">The form contains the following fields:</p><details><summary><span translate=\"true\" keyword=\"Name\">Name</span></summary><div><p translate=\"true\" keywords=\"Account Billable_time Billable_time_invoiced BillableTime Code Count Invoice Invoiced Is Name Rename\">Name of account. The default name is <code>Billable time - invoiced</code> but it can be renamed.</p></div></details><details><summary><span translate=\"true\" keyword=\"Code\">Code</span></summary><div><p translate=\"true\" keywords=\"Account Code Count\">Enter code of the account if desired</p></div></details><details><summary><span translate=\"true\" keyword=\"Group\">Group</span></summary><div><p translate=\"true\" keywords=\"Account And Code Count Group Is On Profit ProfitAndLossStatement Select Sent Statement\">Select group on <code>Profit and Loss Statement</code> under which this account should be presented.</p></div></details><details><summary><span translate=\"true\" keyword=\"Autofill\">Autofill</span> &mdash; <span translate=\"true\" keyword=\"TaxCode\">Tax Code</span></summary><div><p translate=\"true\" keywords=\"Account Code Count Is Select Tax TaxCode TaxCodes\">Select default tax code for this account if you are using <code>Tax Codes</code>.</p></div></details><p translate=\"true\" keywords=\"Code Date On To ToDate Update\">Click <code>Update</code> button to save your changes.</p><p translate=\"true\" keywords=\"Account Accounts Add Automatic Billable_time BillableTime ChartOfAccounts Code Count Delete Is On To ToDate\">This account cannot be deleted, it is automatically added to your <code>Chart of Accounts</code> when you have recorded at least one billable time.</p><p><span translate=\"true\" keywords=\"On\">For more information see:</span> <a href=\"/guides/billable-time\"><span translate=\"true\" keyword=\"BillableTime\">Billable Time</span></a></p>",
  "key": "profit-and-loss-statement-account-billable-time-invoiced-form"
}
