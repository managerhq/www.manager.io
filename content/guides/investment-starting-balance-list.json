{
  "content": "<h1><span translate=\"true\" keyword=\"StartingBalances\">Starting Balances</span> &mdash; <span translate=\"true\" keyword=\"Investments\">Investments</span></h1><p translate=\"true\" keywords=\"Balance Create Investment Investments Is On StartingBalance StartingBalances To ToDate\">This screen allows you to set up starting balances for investments you have created under the <strong>Investments</strong> tab.</p><p translate=\"true\" keywords=\"Balance Find Investment Investments Is On Settings StartingBalance StartingBalances To ToDate\">To find this screen, go to the <strong>Settings</strong> tab, then click <strong>Starting Balances</strong>, then click <strong>Investments</strong>.</p><div class=\"flex pointer-events-none space-x-6 rtl:space-x-reverse items-center\"><div class=\"border rounded p-0.5 inline-block ltr:pr-8 rtl:pl-8\"><div class=\"bg-neutral-200 ltr:pl-8 rtl:pr-8\"><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div><div class=\"border-y ltr:border-l rtl:border-r border-neutral-300 bg-white p-4 flex gap-2 items-center\"><i class=\"fas fa-cog text-neutral-400\"></i><span class=\"font-semibold text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"Settings\">Settings</span></span></div><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div></div></div><span class=\"rtl:hidden\"><i class=\"fas fa-circle-chevron-right text-lg text-neutral-300\"></i></span><span class=\"ltr:hidden\"><i class=\"fas fa-circle-chevron-left text-lg text-neutral-300\"></i></span><div class=\"border rounded inline-block pointer-events-none\"><div class=\"basis-72 flex items-center gap-2 p-4\"><i class=\"text-xl text-neutral-400 fas fa-fw fa-wand-magic-sparkles\"></i><span class=\"text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"StartingBalances\">Starting Balances</span></span></div></div><span class=\"rtl:hidden\"><i class=\"fas fa-circle-chevron-right text-lg text-neutral-300\"></i></span><span class=\"ltr:hidden\"><i class=\"fas fa-circle-chevron-left text-lg text-neutral-300\"></i></span><div class=\"border rounded inline-block pointer-events-none\"><div class=\"basis-72 flex items-center gap-2 p-4\"><i class=\"text-xl text-neutral-400 fas fa-fw fa-chart-pie\"></i><span class=\"text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"Investments\">Investments</span></span></div></div></div><p translate=\"true\" keywords=\"Balance Create Investment NewStartingBalance On StartingBalance To ToDate\">To create a new starting balance for an investment, click the <strong>New Starting Balance</strong> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"Investments\">Investments</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewStartingBalance\">New Starting Balance</span></span></div></div><p translate=\"true\" keywords=\"Balance Investment Investments StartingBalance To ToDate\">You will be taken to the <em>Starting Balance</em> form for <em>Investments</em>.</p><p><span translate=\"true\" keywords=\"On\">For more information, see:</span> <a href=\"/guides/investment-starting-balance-form\"><span translate=\"true\" keyword=\"StartingBalance\">Starting balance</span> &mdash; <span translate=\"true\" keyword=\"Investment\">Investment</span> &mdash; <span translate=\"true\" keyword=\"Edit\">Edit</span></a></p>",
  "key": "investment-starting-balance-list"
}
