{
  "content": "<h1><span translate=\"true\" keyword=\"AgedPayables\">Aged Payables</span></h1><p translate=\"true\" keywords=\"AgedPayables And By Invoice Invoices Paid Port Supplier Unpaid\">The <em>Aged Payables</em> report provides a detailed breakdown of your outstanding supplier invoices, organized by the length of time they have remained unpaid.</p><p translate=\"true\" keywords=\"And Invoice Invoices Is On Overdue Payment Port To ToDate\">This report helps you monitor your payment obligations and identify overdue invoices that require immediate attention.</p><p translate=\"true\" keywords=\"AgedPayables Create NewReport On Port Reports To ToDate\">To create a new report, go to the <strong>Reports</strong> tab, click <strong>Aged Payables</strong>, then click the <strong>New Report</strong> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"AgedPayables\">Aged Payables</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewReport\">New Report</span></span></div></div>",
  "key": "aged-payables-list"
}
