{
  "content": "<h1><span translate=\"true\" keyword=\"GeneralLedgerTransactions\">General Ledger Transactions</span></h1><p translate=\"true\" keywords=\"Action General_ledger GeneralLedgerTransactions On Port Reports Transaction Transactions\">The General Ledger Transactions form configures parameters for transaction reports.</p><p translate=\"true\" keywords=\"And Date Filter General_ledger SetDate To ToDate View\">Set date ranges and filters to view detailed general ledger entries.</p><details><summary><span translate=\"true\" keyword=\"Description\">Description</span></summary><div><p translate=\"true\" keywords=\"Description Is On Optional Port\">Enter an optional description for this report.</p></div></details><details><summary><span translate=\"true\" keyword=\"FromDate\">From</span></summary><div><p translate=\"true\" keywords=\"Action Date On StartDate Transaction\">Enter the start date for the transaction period.</p></div></details><details><summary><span translate=\"true\" keyword=\"ToDate\">To</span></summary><div><p translate=\"true\" keywords=\"Action Date On Transaction\">Enter the end date for the transaction period.</p></div></details><details><summary><span translate=\"true\" keyword=\"Account\">Account</span></summary><div><p translate=\"true\" keywords=\"Account Accounts Action Count On Select To ToDate Transaction Transactions View\">Select the account to view transactions for. Leave blank to show all accounts.</p></div></details>",
