{
  "content": "<h1><span translate=\"true\" keyword=\"PayslipItems\">Payslip Items</span></h1><p translate=\"true\" keywords=\"And Employee Is Item On Payslip PayslipItems Payslips Settings To ToDate\">The <strong>Payslip Items</strong> screen, found under the <strong>Settings</strong> tab, is used to define and manage items that appear on employee payslips.</p><p translate=\"true\" keywords=\"And Contribution Contributions Deduction Deductions Earnings Employee Item On Sent Type\">These items represent various types of earnings, deductions, and contributions that make up an employee's pay.</p><p translate=\"true\" keywords=\"And Contribution Contributions Deduction Deductions On Other Tax\">Examples include wages, overtime, tax withholdings, pension contributions, and other benefits or deductions.</p><div class=\"flex pointer-events-none space-x-6 rtl:space-x-reverse items-center\"><div class=\"border rounded p-0.5 inline-block ltr:pr-8 rtl:pl-8\"><div class=\"bg-neutral-200 ltr:pl-8 rtl:pr-8\"><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div><div class=\"border-y ltr:border-l rtl:border-r border-neutral-300 bg-white p-4 flex gap-2 items-center\"><i class=\"fas fa-cog text-neutral-400\"></i><span class=\"font-semibold text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"Settings\">Settings</span></span></div><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div></div></div><span class=\"rtl:hidden\"><i class=\"fas fa-circle-chevron-right text-lg text-neutral-300\"></i></span><span class=\"ltr:hidden\"><i class=\"fas fa-circle-chevron-left text-lg text-neutral-300\"></i></span><div class=\"border rounded inline-block pointer-events-none\"><div class=\"basis-72 flex items-center gap-2 p-4\"><i class=\"text-xl text-neutral-400 fas fa-fw fa-tasks-alt\"></i><span class=\"text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"PayslipItems\">Payslip Items</span></span></div></div></div>",
  "key": "payslip-items"
}
