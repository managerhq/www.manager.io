{
  "content": "<h1><span translate=\"true\" keyword=\"CashFlowStatement\">Cash Flow Statement</span></h1><p translate=\"true\" keywords=\"And Business CashFlowStatement Code Inflows On Outflows Statement To ToDate View\">The <code>Cash Flow Statement</code> provides a comprehensive overview of your business's cash inflows and outflows, helping you monitor liquidity, assess financial stability.</p><p translate=\"true\" keywords=\"CashFlowStatement Code Create NewReport On Port Reports Statement To ToDate\">To create a new <code>Cash Flow Statement</code>, go to <code>Reports</code> tab, click <code>Cash Flow Statement</code>, then <code>New Report</code> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"CashFlowStatement\">Cash Flow Statement</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewReport\">New Report</span></span></div></div>",
  "key": "cash-flow-statement-list"
