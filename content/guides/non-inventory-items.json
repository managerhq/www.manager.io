{
  "content": "<h1><span translate=\"true\" keyword=\"NonInventoryItems\">Non-inventory Items</span></h1><p translate=\"true\" keywords=\"And Automatic InventoryItem InventoryItems Invoice Invoices Item Line NonInventoryItem NonInventoryItems On Orders Quote Quotes To ToDate\">Non-inventory items are products or services that you buy and sell but don't need to track quantities for. They automatically populate line items on your invoices, orders, and quotes, saving you time on data entry.</p><p translate=\"true\" keywords=\"And HasWhere InventoryItem InventoryItems Is Item NonInventoryItem NonInventoryItems On To ToDate\">Unlike <em>inventory items</em>, non-inventory items are not monitored for quantity on hand or inventory value. This makes them perfect for services, labor charges, or products where you don't need inventory control.</p><p translate=\"true\" keywords=\"Item Line On\">Common uses include professional services, consultation fees, shipping charges, or any frequently used line items that don't require quantity tracking.</p><p translate=\"true\" keywords=\"And InventoryItem InventoryItems Item NonInventoryItem NonInventoryItems On Settings To ToDate\">To access non-inventory items, go to the <strong>Settings</strong> tab and click <strong>Non-Inventory Items</strong>.</p><div class=\"flex pointer-events-none space-x-6 rtl:space-x-reverse items-center\"><div class=\"border rounded p-0.5 inline-block ltr:pr-8 rtl:pl-8\"><div class=\"bg-neutral-200 ltr:pl-8 rtl:pr-8\"><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div><div class=\"border-y ltr:border-l rtl:border-r border-neutral-300 bg-white p-4 flex gap-2 items-center\"><i class=\"fas fa-cog text-neutral-400\"></i><span class=\"font-semibold text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"Settings\">Settings</span></span></div><div class=\"border-x border-neutral-300 bg-neutral-100 h-2\"></div></div></div><span class=\"rtl:hidden\"><i class=\"fas fa-circle-chevron-right text-lg text-neutral-300\"></i></span><span class=\"ltr:hidden\"><i class=\"fas fa-circle-chevron-left text-lg text-neutral-300\"></i></span><div class=\"border rounded inline-block pointer-events-none\"><div class=\"basis-72 flex items-center gap-2 p-4\"><i class=\"text-xl text-neutral-400 fas fa-fw fa-th\"></i><span class=\"text-sm text-[#428bca]\"><span translate=\"true\" keyword=\"NonInventoryItems\">Non-inventory Items</span></span></div></div></div>",
  "key": "non-inventory-items"
}
