{
  "content": "<h1><span translate=\"true\" keyword=\"RecurringInterAccountTransfers\">Recurring Inter Account Transfers</span> &mdash; <span translate=\"true\" keyword=\"Pending\">Pending</span></h1><p translate=\"true\" keywords=\"Account Accounts And Automatic Bank_account BankAccount Count InterAccountTransfer InterAccountTransfers On RecurringInterAccountTransfer RecurringInterAccountTransfers To ToDate Transfer\">Recurring inter account transfers automatically move funds between your <em>bank accounts</em> and <em>cash accounts</em> on a regular schedule.</p><p translate=\"true\" keywords=\"Account Accounts Allocation Count Deposit Is Location On Payment Payments To ToDate Transfer\">Use this feature to automate routine transfers such as monthly savings deposits, loan repayments, or regular fund allocations between accounts.</p><p translate=\"true\" keywords=\"And Automatic Create Is On To ToDate Transfer\">Each recurring transfer will be created automatically based on the schedule you define, saving time and ensuring consistency.</p><details><summary><span translate=\"true\" keyword=\"NextIssueDate\">Next issue date</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"NextIssueDate\">Next issue date</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Account Automatic Count Create Date InterAccountTransfer Is Next On To ToDate Transfer\">Displays the date when the next <em>inter account transfer</em> will be automatically created based on the recurring schedule.</p></div></details><details><summary><span translate=\"true\" keyword=\"PaidFrom\">Paid from</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"PaidFrom\">Paid from</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Account Count From FromDate Transfer\">Shows the source account from which funds will be transferred.</p></div></details><details><summary><span translate=\"true\" keyword=\"ReceivedIn\">Received in</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"ReceivedIn\">Received in</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Account Count HasWhere On Received\">Shows the destination account where funds will be received.</p></div></details><details><summary><span translate=\"true\" keyword=\"Description\">Description</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"Description\">Description</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Action Description On Reference Transaction Transfer\">Shows the description or reference for the recurring transfer transaction.</p></div></details><details><summary><span translate=\"true\" keyword=\"Amount\">Amount</span></summary><div><div class=\"my-4\"><div class=\"border rounded p-0.5 pointer-events-none text-sm w-max\"><div class=\"grid grid-cols-[1.25rem_auto_1.25rem] bg-neutral-200 gap-[1px]\"><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 h-2\"></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-100 font-bold text-neutral-500 text-shadow px-4 py-2 border-t border-t-white\"><span translate=\"true\" keyword=\"Amount\">Amount</span></div><div class=\"bg-neutral-100 border-t border-t-white\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div><div class=\"bg-neutral-50 border-t border-white h-2\"></div></div></div></div><p translate=\"true\" keywords=\"Account Amount Count Currency To ToDate Transfer\">Shows the amount to be transferred in the currency of the source account.</p></div></details>",
