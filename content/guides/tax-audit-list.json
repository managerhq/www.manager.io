{
  "content": "<h1><span translate=\"true\" keyword=\"TaxAudit\">Tax Audit</span></h1><p translate=\"true\" keywords=\"Action Code On Port Summary Tax TaxAudit TaxCode TaxCodes Transaction Transactions\">The <em>Tax Audit</em> report provides a comprehensive summary of how transactions have been categorized across tax codes for a specific period.</p><p translate=\"true\" keywords=\"Action And Code Is On Port Tax TaxCode TaxCodes To ToDate Transaction Transactions\">This report helps you verify that transactions have been assigned to the correct tax codes and can assist with tax compliance and filing.</p><p translate=\"true\" keywords=\"Create NewReport On Port Reports Tax TaxAudit To ToDate\">To create a new tax audit report, go to the <strong>Reports</strong> tab, click <strong>Tax Audit</strong>, then click the <strong>New Report</strong> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"TaxAudit\">Tax Audit</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewReport\">New Report</span></span></div></div>",
  "key": "tax-audit-list"
}
