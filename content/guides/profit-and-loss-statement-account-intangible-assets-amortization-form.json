{
  "content": "<h1><span translate=\"true\" keyword=\"Account\">Account</span> &mdash; <span translate=\"true\" keyword=\"IntangibleAssetsAmortization\">Intangible assets - amortization</span></h1><p translate=\"true\" keywords=\"Account Amortization Assets Code Count Intangible_asset IntangibleAsset IntangibleAssets IntangibleAssetsAmortization Is Name On Rename To ToDate\">This form allows to rename built-in <code>Intangible assets - amortization</code> account.</p><p translate=\"true\" keywords=\"Account Accounts Amortization Assets ChartOfAccounts Code Count Edit Intangible_asset IntangibleAsset IntangibleAssets IntangibleAssetsAmortization Is On Settings To ToDate\">To access this form, go to <code>Settings</code>, then <code>Chart of Accounts</code>, then click <code>Edit</code> button for <code>Intangible assets - amortization</code> account.</p><p translate=\"true\" keywords=\"Contains On\">The form contains the following fields:</p><details><summary><span translate=\"true\" keyword=\"Name\">Name</span></summary><div><p translate=\"true\" keywords=\"Account Amortization Assets Code Count Intangible_asset IntangibleAsset IntangibleAssets IntangibleAssetsAmortization Is Name On Rename\">Name of account. The default name is <code>Intangible assets - amortization</code> but it can be renamed.</p></div></details><details><summary><span translate=\"true\" keyword=\"Code\">Code</span></summary><div><p translate=\"true\" keywords=\"Account Code Count\">Enter code of the account if desired</p></div></details><details><summary><span translate=\"true\" keyword=\"Group\">Group</span></summary><div><p translate=\"true\" keywords=\"Account And Code Count Group Is On Profit ProfitAndLossStatement Select Sent Statement\">Select group on <code>Profit and Loss Statement</code> under which this account should be presented.</p></div></details><p translate=\"true\" keywords=\"Code Date On To ToDate Update\">Click <code>Update</code> button to save your changes.</p><p translate=\"true\" keywords=\"Account Accounts Add Amortization AmortizationEntry Automatic ChartOfAccounts Code Count Delete Is On To ToDate\">This account cannot be deleted, it is automatically added to your <code>Chart of Accounts</code> when you have at least one amortization entry.</p><p><span translate=\"true\" keywords=\"On\">For more information see:</span> <a href=\"/guides/amortization-entries\"><span translate=\"true\" keyword=\"AmortizationEntries\">Amortization Entries</span></a></p>",
  "key": "profit-and-loss-statement-account-intangible-assets-amortization-form"
