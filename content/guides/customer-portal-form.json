{
  "content": "<h1><span translate=\"true\" keyword=\"CustomerPortal\">Customer Portal</span></h1><p translate=\"true\" keywords=\"Custom Customer CustomerPortal On Port To ToDate\">Configure a customer portal for self-service access.</p><p translate=\"true\" keywords=\"And Custom Customer Customers Invoice Invoices Line On Payment Payments Statement To ToDate View\">Customers can view invoices, statements, and make payments online.</p><details><summary><span translate=\"true\" keyword=\"Customer\">Customer</span></summary><div><p translate=\"true\" keywords=\"Custom Customer Port Select To ToDate\">Select the customer who will have access to the portal.</p></div></details><details><summary><span translate=\"true\" keyword=\"SalesQuotes\">Sales Quotes</span></summary><div><p translate=\"true\" keywords=\"Custom Customer Is Quote Quotes Sales SalesQuote SalesQuotes To ToDate View\">Check this box to allow the customer to view their sales quotes.</p></div></details><details><summary><span translate=\"true\" keyword=\"SalesOrders\">Sales Orders</span></summary><div><p translate=\"true\" keywords=\"Custom Customer Is Orders Sales SalesOrder SalesOrders To ToDate View\">Check this box to allow the customer to view their sales orders.</p></div></details><details><summary><span translate=\"true\" keyword=\"SalesInvoices\">Sales Invoices</span></summary><div><p translate=\"true\" keywords=\"Custom Customer Invoice Invoices Is Sales SalesInvoice SalesInvoices To ToDate View\">Check this box to allow the customer to view their sales invoices.</p></div></details><details><summary><span translate=\"true\" keyword=\"CreditNotes\">Credit Notes</span></summary><div><p translate=\"true\" keywords=\"Credit CreditNote CreditNotes Custom Customer Edit Is Notes To ToDate View\">Check this box to allow the customer to view their credit notes.</p></div></details><details><summary><span translate=\"true\" keyword=\"DeliveryNotes\">Delivery Notes</span></summary><div><p translate=\"true\" keywords=\"Custom Customer DeliveryNote DeliveryNotes Is Notes To ToDate View\">Check this box to allow the customer to view their delivery notes.</p></div></details>",
