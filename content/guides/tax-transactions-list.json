{
  "content": "<h1><span translate=\"true\" keyword=\"TaxTransactions\">Tax Transactions</span></h1><p translate=\"true\" keywords=\"Action Is On Port Tax TaxTransactions Transaction Transactions\">The <em>Tax Transactions</em> report displays a list of all tax-related transactions for a specified period.</p><p translate=\"true\" keywords=\"Amount And Is Paid Port Tax TaxAmount TaxAmounts View\">This report helps you review and analyze tax amounts collected and paid, making it useful for tax compliance and reporting.</p><p translate=\"true\" keywords=\"Action Create NewReport On Port Reports Tax TaxTransactions To ToDate Transaction Transactions\">To create a new tax transactions report, go to the <strong>Reports</strong> tab, click <strong>Tax Transactions</strong>, then click the <strong>New Report</strong> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"TaxTransactions\">Tax Transactions</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewReport\">New Report</span></span></div></div>",
  "key": "tax-transactions-list"
}
