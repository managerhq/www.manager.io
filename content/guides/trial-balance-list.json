{
  "content": "<h1><span translate=\"true\" keyword=\"TrialBalance\">Trial Balance</span></h1><p translate=\"true\" keywords=\"Account And Balance Balanced Business By Code Count Credit Debit Edit Is On Position To ToDate TrialBalance\"><code>Trial Balance</code> a vital tool that provides a snapshot of your business's financial performance and position by listing all ledger account balances and ensuring that debits and credits are balanced.</p><p translate=\"true\" keywords=\"Balance Code Create NewReport On Port Reports To ToDate TrialBalance\">To create a new <code>Trial Balance</code>, go to <code>Reports</code> tab, click <code>Trial Balance</code>, then <code>New Report</code> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"TrialBalance\">Trial Balance</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewReport\">New Report</span></span></div></div>",
  "key": "trial-balance-list"
}
