{
  "content": "<h1><span translate=\"true\" keyword=\"StartingBalances\">Starting Balances</span> &mdash; <span translate=\"true\" keyword=\"SalesInvoices\">Sales Invoices</span></h1><p translate=\"true\" keywords=\"Balance Create Invoice Invoices Is On Sales SalesInvoice SalesInvoices StartingBalance StartingBalances To ToDate\">This screen allows you to set up starting balances for sales invoices that you have created under the <strong>Sales Invoices</strong> tab.</p><p translate=\"true\" keywords=\"Account Balance Count From FromDate Invoice Invoices Is Paid Sales SalesInvoice SalesInvoices StartingBalance StartingBalances To ToDate Unpaid\">Starting balances are used to record unpaid sales invoices from your previous accounting system when you begin using this software.</p><p translate=\"true\" keywords=\"Balance Create Invoice NewStartingBalance On Sales SalesInvoice StartingBalance To ToDate\">To create a new starting balance for a sales invoice, click the <strong>New Starting Balance</strong> button.</p><div class=\"border rounded p-0.5 inline-block pointer-events-none\"><div class=\"mt-4 ms-4 pe-8 items-center bg-neutral-100 p-4 border-neutral-200 border-s border-t rounded-ss-lg flex gap-4 shadow-[inset_0px_1px_0px_#fff]\"><span class=\"text-base font-bold text-neutral-300 [text-shadow:_1px_1px_0px_#fff]\"><span translate=\"true\" keyword=\"SalesInvoices\">Sales Invoices</span></span><span class=\"text-neutral-300 hover:text-neutral-400\"><i class=\"fas fa-square-question\" style=\"font-size: 16px\"></i></span><span class=\"bg-white text-neutral-700 border border-neutral-300 font-semibold rounded-md py-2 px-4 text-sm\"><span translate=\"true\" keyword=\"NewStartingBalance\">New Starting Balance</span></span></div></div><p translate=\"true\" keywords=\"Balance Invoice Sales SalesInvoice StartingBalance To ToDate\">You will be taken to the <em>Starting Balance</em> screen for <em>Sales Invoice</em>.</p><p><span translate=\"true\" keywords=\"On\">For more information, see:</span> <a href=\"/guides/sales-invoice-starting-balance-form\"><span translate=\"true\" keyword=\"StartingBalance\">Starting balance</span> &mdash; <span translate=\"true\" keyword=\"SalesInvoice\">Sales Invoice</span> &mdash; <span translate=\"true\" keyword=\"Edit\">Edit</span></a></p>",
  "key": "sales-invoice-starting-balance-list"
}
