  "paths": {
    "/api4/recalculated-inventory-unit-costs": {
      "get": {
        "parameters": [
          {
            "name": "FromDate",
            "in": "query",
            "description": "Recalculate inventory unit costs from this date forward. If omitted, recalculates from the beginning of time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "Business",
            "in": "query",
            "description": "Name of business. If you are calling API from an extension running within IFRAME, then business does not have to be provided. Manager will automatically inject current business. This is useful when extension doesn't know business name which is typically the case.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InventoryUnitCost"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
